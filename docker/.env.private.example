# TEMPLATE — copy to .env.private on the host and fill in real values.
#
#   cp docker/.env.private.example docker/.env.private
#   chmod 600 docker/.env.private
#
# .env.private is gitignored and is concatenated with .env into .env.combined
# at deploy time (see ansible/roles/docker/tasks/deploy.yaml).
#
# This list was derived mechanically — every ${VAR} referenced by
# docker-compose.pi0.yaml or docker-compose.pi1.yaml that is NOT defined in
# docker/.env — and cross-checked against pi0's live .env.private. If you add
# a new ${VAR} to a compose file, add it to .env or here.
#
# Only pi0 needs this file: all five secrets below are referenced solely by
# docker-compose.pi0.yaml. pi1 currently has no .env.private at all.

# --- Traefik / DuckDNS -------------------------------------------------------
# ACME DNS-01 challenge for *.dpinhas.duckdns.org. Also grants full control of
# the DuckDNS domain, so treat it as high-value.
DUCKDNS_TOKEN=

# --- Tailscale --------------------------------------------------------------
# Reusable or ephemeral auth key from the Tailscale admin console.
TS_AUTH_KEY=

# --- *arr API keys (consumed by the exportarr Prometheus exporters) ---------
# Each app: Settings -> General -> API Key.
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=
